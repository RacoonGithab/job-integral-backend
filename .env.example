# =========================================
# Application
# =========================================
APP_PORT=           # Port on which the backend server will run (e.g., 3000)

# =========================================
# PostgreSQL Database
# =========================================
DB_NAME=            # Name of your PostgreSQL database
DB_USER=            # PostgreSQL username
DB_PASSWORD=        # PostgreSQL password
DATABASE_URL=       # Full PostgreSQL connection string (e.g., postgres://user:password@host:port/dbname)

# =========================================
# MongoDB Database
# =========================================
MONGO_USER=         # MongoDB username
MONGO_PASSWORD=     # MongoDB password
MONGO_PORT=         # MongoDB port (default: 27017)
MONGO_DB=           # MongoDB database name
MONGO_URL=          # Full MongoDB connection string (e.g., mongodb://user:password@host:port/dbname)

# =========================================
# Hasura (if used)
# =========================================
HASURA_GRAPHQL_ENABLE_CONSOLE=   # Enable Hasura console (true/false)
HASURA_GRAPHQL_ADMIN_SECRET=     # Hasura admin secret for GraphQL API

# =========================================
# Redis
# =========================================
REDIS_CONTAINER_NAME=  # Redis container name if using Docker
REDIS_PORT=            # Redis port (default: 6379)
REDIS_HOST=            # Redis host (e.g., localhost or container name)

# =========================================
# JWT and Token Secrets
# =========================================
JWT_ACCESS_SECRET=           # Secret key for signing access tokens
JWT_REFRESH_SECRET=          # Secret key for signing refresh tokens
JWT_RESET_PASSWORD_SECRET=   # Secret key for password reset tokens

# =========================================
# Token Validity Periods
# =========================================
REFRESH_TOKEN_EXPIRES_IN=        # Refresh token validity (e.g., 7d, 30d)
ACCESS_TOKEN_EXPIRES_IN=         # Access token validity (e.g., 15m, 1h)
RESET_PASSWORD_TOKEN_EXPIRES_IN= # Reset password token validity (e.g., 1h)

# =========================================
# Password Reset Limits
# =========================================
RESET_PASSWORD_MAX_REQUESTS=      # Maximum password reset requests per user within the window
RESET_PASSWORD_WINDOW_SECONDS=    # Time window for password reset limit in seconds

# =========================================
# Verification Codes
# =========================================
VERIFICATION_CODE_TTL=            # Time-to-live for verification codes in seconds
MAX_CODE_ATTEMPTS=                # Maximum attempts to enter a verification code
MAX_DAILY_VERIFICATION_CODES=     # Maximum verification codes sent per day

# =========================================
# Email / SMTP Settings
# =========================================
SMTP_EMAIL_HOST=         # SMTP server host (e.g., smtp.gmail.com)
SMTP_EMAIL_PORT=         # SMTP server port (e.g., 587)
EMAIL_HOST_USER=         # Email username/login
EMAIL_HOST_PASSWORD=     # Email password or app-specific password

# =========================================
# Firebase Service Account
# =========================================
FIREBASE_PROJECT_ID=     # Firebase project ID
FIREBASE_PRIVATE_KEY_ID= # Firebase private key ID
FIREBASE_PRIVATE_KEY=    # Firebase private key (multiline, include BEGIN/END lines with \n for line breaks)
FIREBASE_CLIENT_EMAIL=   # Firebase client email
FIREBASE_CLIENT_ID=      # Firebase client ID
FIREBASE_STORAGE_BUCKET= # Firebase storage bucket name