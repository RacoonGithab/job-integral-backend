// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String?
  role      Roles     @default(EMPLOYEE)
  isBlocked Boolean   @default(false) @map("is_blocked")
  blockedAt DateTime? @map("blocked_at")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  TemporaryPassword  TemporaryPassword?   @relation("UserTemporaryPassword")
  VerificationCode   VerificationCode[]   @relation("UserVerificationCode")
  Session            Session[]            @relation("UserSession")
  PasswordResetToken PasswordResetToken[] @relation("PasswordResetToken")

  chats        ChatMember[]  @relation("ChatMember")
  Messages     Message[]     @relation("Message")
  messageReads MessageRead[] @relation("UserMessageReads")

  @@map("users")
}

enum Roles {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  SECOND_FACTOR_LOGIN
}

model Session {
  id       String  @id @default(uuid())
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation("UserSession", fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model TemporaryPassword {
  id           String   @id @default(uuid())
  passwordHash String   @map("password_hash")
  createdAt    DateTime @map("created_at")

  userId String @unique @map("user_id")
  user   User   @relation("UserTemporaryPassword", fields: [userId], references: [id], onDelete: Cascade)

  @@map("temporary_passwords")
}

model VerificationCode {
  id               String               @id @default(uuid())
  verificationCode String               @map("verification_code")
  type             VerificationCodeType
  isActive         Boolean              @default(true) @map("is_active")
  attempts         Int                  @default(0)
  expiredAt        DateTime             @map("expired_at")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  User   User   @relation("UserVerificationCode", fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_codes")
}

model PasswordResetToken {
  id          String  @id @default(uuid())
  token       String
  isActive    Boolean @default(true) @map("is_active")
  isConfirmed Boolean @default(false) @map("is_confirmed")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  User   User   @relation("PasswordResetToken", fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Chat {
  id   String   @id @default(uuid())
  name String?
  type ChatType @default(DIRECT)

  members  ChatMember[] @relation("ChatMember")
  messages Message[]    @relation("Message")

  createdAt DateTime @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chats")
}

enum ChatType {
  DIRECT
  GROUP
}

model ChatMember {
  id   String   @id @default(uuid())
  role ChatRole @default(MEMBER)

  user   User   @relation("ChatMember", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  chat   Chat   @relation("ChatMember", fields: [chatId], references: [id], onDelete: Cascade)
  chatId String

  joinedAt  DateTime @map("joined_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, chatId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_members")
}

enum ChatRole {
  CREATOR
  ADMIN
  MEMBER
}

model Message {
  id   String @id @default(uuid())
  text String

  chat   Chat   @relation("Message", fields: [chatId], references: [id], onDelete: Cascade)
  chatId String

  sender   User   @relation("Message", fields: [senderId], references: [id], onDelete: Cascade)
  senderId String

  reads MessageRead[] @relation("MessageReads")

  createdAt DateTime
  editedAt  DateTime? @map("edited_at")

  @@index([chatId])
  @@index([senderId])
  @@map("messages")
}

model MessageRead {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  userId    String @map("user_id")

  message Message @relation("MessageReads", fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation("UserMessageReads", fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @map("read_at")

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reads")
}
